<!-- The Survivors screen, in the game's menu in place of the main menu: where to fight, what to sail with, and the
     permanent bonuses every run gets, then BACK or LAUNCH. Three columns that scroll on their own within the screen's
     height, with the buttons in a footer below them. Explicit colours, the menu's grey and the logo's red, since the
     menu carries no brushes for a page like this. Laid out at 1080p; the menu scales its pages. Bound to SurvivorsScreen. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#C0000000">
    <Grid.Resources>
        <SolidColorBrush x:Key="Text" Color="#FFE8E8E8"/>
        <SolidColorBrush x:Key="Muted" Color="#FFB0B6BD"/>
        <SolidColorBrush x:Key="Amber" Color="#FFF0A030"/>
        <SolidColorBrush x:Key="Rule" Color="#FF3A3F45"/>

        <!-- A button that is only its content, a background and a frame, lit on hover and faded when disabled -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hover" Background="#18FFFFFF" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- A flagship or a starting ship: a lit bar down the left when chosen, the name and what it is, and its state or price -->
        <DataTemplate x:Key="ShipRow">
            <Button Style="{StaticResource Flat}" Command="{Binding Command}" Background="{Binding Fill}" Margin="0,0,0,6" Height="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Bar}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="17" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding DetailVisibility}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="14" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Grid.Resources>

    <!-- The menu scales pages by the screen's height, so the width left at 1080p is narrower on a 16:10 screen than at 16:9 -->
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1680" Margin="24,40" Padding="32,24"
            Background="#F2181B1F" BorderBrush="{StaticResource Rule}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: the title and the bank -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="5" HorizontalAlignment="Left" Background="#FFA4161A"/>
                <StackPanel Margin="20,0,0,0">
                    <TextBlock Text="SURVIVORS" FontSize="36" Foreground="#FFFFFFFF"/>
                    <TextBlock Text="Hold out for 75 minutes of game time against waves of ships and aircraft. Every kill is XP; every level is an upgrade."
                               FontSize="15" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Bank}" FontSize="24" Foreground="{StaticResource Amber}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Earned}" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Choosing ensigns: every flag, what it gives and costs. Click to unlock, hoist or strike. -->
            <ScrollViewer Grid.Row="1" Visibility="{Binding EnsignPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="ENSIGNS" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                    <TextBlock Text="Fly up to three for a run. Each one gives something and takes something."
                               FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding EnsignCards}" Margin="0,0,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Flat}" Command="{Binding Command}" Background="{Binding Fill}" Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Bar}"/>
                                        <StackPanel Grid.Column="1" Margin="12,10,10,10">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Flag}" Width="54" Height="36" Stretch="Fill" Opacity="{Binding FlagOpacity}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Navy}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="13" Foreground="{Binding StateBrush}" VerticalAlignment="Top"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Boon}" FontSize="13" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Cost}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Visibility="{Binding MainPage}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="3.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Location: a card for each area, then the chosen one's briefing -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="LOCATION" Style="{StaticResource Heading}"/>
                        <ItemsControl ItemsSource="{Binding Areas}" Margin="0,0,-10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Flat}" Command="{Binding Command}" Height="118" Margin="0,0,10,10">
                                        <Grid ClipToBounds="True">
                                            <Border Background="#FF2A3038"/>
                                            <Image Source="{Binding Art}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border VerticalAlignment="Bottom" Padding="12,18,12,8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#D0000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="17" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Region}" FontSize="12" Foreground="#FFD0D4D8" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{Binding Frame}" BorderThickness="3"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AreaName}" FontSize="22" Foreground="#FFFFFFFF" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding AreaBlurb}" FontSize="15" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="21"/>
                        <TextBlock Text="{Binding AreaApproach}" FontSize="14" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Fleet: the flagship, then the starting ships and flights of its navy -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="FLAGSHIP" Style="{StaticResource Heading}"/>
                        <ItemsControl ItemsSource="{Binding Flagships}" ItemTemplate="{StaticResource ShipRow}"/>
                        <TextBlock Text="STARTING SHIPS AND FLIGHTS" Style="{StaticResource Heading}" Margin="0,18,0,2"/>
                        <TextBlock Text="Bought ones sail with the flagship. Click one to leave it ashore."
                                   FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Escorts}" ItemTemplate="{StaticResource ShipRow}"/>
                        <TextBlock Text="{Binding FleetSummary}" FontSize="15" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Ensigns, then the starting bonuses: the permanent upgrades, rank by rank -->
                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="ENSIGNS" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource Flat}" Command="{Binding EnsignsCommand}" Background="#FF22262B" Margin="0,0,0,18">
                            <Grid Margin="14,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ItemsControl ItemsSource="{Binding EnsignSlots}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="48" Height="32" Margin="0,0,8,0" BorderBrush="{StaticResource Rule}" BorderThickness="1">
                                                <Image Source="{Binding Flag}" Stretch="Fill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="1" Text="{Binding EnsignSummary}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="STARTING BONUSES" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                        <TextBlock Text="Every run gets them. Each rank bought raises the price of the next."
                                   FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Bonuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF22262B" Padding="14,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="17" Foreground="{StaticResource Text}"/>
                                                <ItemsControl ItemsSource="{Binding Pips}" Margin="0,5,0,5">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding}" Width="18" Height="6" Margin="0,0,4,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding PerRank}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource Flat}" Command="{Binding Command}" VerticalAlignment="Center"
                                                    Width="96" Height="36" BorderBrush="{StaticResource Amber}" BorderThickness="1">
                                                <TextBlock Text="{Binding Price}" FontSize="14" Foreground="{StaticResource Amber}" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Flat}" Command="{Binding RefundCommand}" HorizontalAlignment="Left" Padding="0,8" Margin="0,6,0,0">
                            <TextBlock Text="{Binding RefundText}" FontSize="14" Foreground="{StaticResource Muted}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer: BACK, what happened last, and LAUNCH -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Flat}" Command="{Binding BackCommand}" Width="160" Height="52"
                        BorderBrush="{StaticResource Rule}" BorderThickness="1">
                    <TextBlock Text="{Binding BackText}" FontSize="20" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="15" Foreground="{StaticResource Amber}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="24,0" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Style="{StaticResource Flat}" Command="{Binding LaunchCommand}" Width="260" Height="52"
                        Background="#FFA4161A">
                    <TextBlock Text="{Binding LaunchText}" FontSize="22" Foreground="#FFFFFFFF" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Grid>

<!-- The Survivors screen, in the game's menu in place of the main menu: where to fight, what to sail with, and the
     permanent bonuses every run gets, then BACK or LAUNCH. Three panes that scroll on their own within the screen's
     height, with the buttons in a footer below them. Colours, buttons and sizes are the game's own, from its theme
     (NoesisTheme.Brushes.DarkRed, NoesisTheme.Fonts, SeaPower.Theme.Custom): resources are looked up dynamically, as
     Dynamic Campaign Mod's are, and Buttons without a Style take the game's. Caps on buttons and field labels only.
     Laid out at 1080p; the menu scales its pages. Bound to SurvivorsScreen. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Window.BackgroundDark}"
      TextElement.Foreground="{DynamicResource Brush.Foreground.Normal}">
    <Grid.Resources>
        <!-- A list row or card: the game's list colours and press, with the red edge of its Task Force buttons on hover -->
        <ControlTemplate x:Key="RowTemplate" TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform/>
                </Grid.RenderTransform>
                <Border Background="{TemplateBinding Background}"/>
                <ContentPresenter x:Name="Content" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Border x:Name="Edge" BorderBrush="{DynamicResource Brush.Border.FocusAccent}" BorderThickness="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Resources>
                <Storyboard x:Key="Press">
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.99" Duration="0:0:0.1" DecelerationRatio="0.25"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.99" Duration="0:0:0.1" DecelerationRatio="0.25"/>
                </Storyboard>
                <Storyboard x:Key="Release">
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2" DecelerationRatio="1"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2" DecelerationRatio="1"/>
                </Storyboard>
            </ControlTemplate.Resources>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Item.BackgroundOver}"/>
                    <Setter TargetName="Edge" Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource Press}"/>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource Release}"/>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.Button.BackgroundDisabled}"/>
                    <Setter TargetName="Content" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Brush.ListBox.Background}"/>
            <Setter Property="Template" Value="{StaticResource RowTemplate}"/>
        </Style>
        <!-- Selected as the game's lists are: a red fill, which a style trigger keeps through the hover -->
        <Style x:Key="SelectableRow" TargetType="Button" BasedOn="{StaticResource Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Item.BackgroundSelected}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The Options menu's section header and the rule under it -->
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Highlight}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Foreground.Highlight}"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- The game's debrief panel, without its dark fill: the rows inside carry that -->
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Window.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="Name" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Highlight}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Normal}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Grey on red would not read, so a selected row's quieter text lights up -->
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Highlight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A row's state: quiet, in the game's emphasis colour if it is a price -->
        <Style x:Key="State" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Normal}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Emphasis}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Emphasis}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Highlight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Points" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Emphasis}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Highlight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A rank or a point, filled in the colour of the game's progress bars -->
        <Style x:Key="Pip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Track.Normal}"/>
            <Setter Property="Height" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.ProgressBar.Fill}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A flagship or a starting ship: the name and what it is, and its state or price -->
        <DataTemplate x:Key="ShipRow">
            <Button Style="{StaticResource SelectableRow}" Command="{Binding Command}" Margin="0,0,0,4" MinHeight="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="12,4,8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Name}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource RowNote}" TextWrapping="Wrap" Visibility="{Binding DetailVisibility}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource State}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Grid.Resources>

    <!-- The menu scales pages by the screen's height, so the width left at 1080p is narrower on a 16:10 screen than at 16:9 -->
    <Grid Margin="33,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the title and the bank -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SURVIVORS" FontSize="36" Foreground="{DynamicResource Brush.Foreground.Highlight}" Margin="0,17.5,0,0"/>
                <TextBlock Text="Select a map, a fleet, your Ensigns, and survive for 20 minutes."
                           FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Bank}" FontSize="16" Foreground="{DynamicResource Brush.Foreground.Emphasis}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding Earned}" FontSize="12" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Choosing ensigns: every flag, what it does and takes from the budget. Click to unlock, hoist or strike. -->
        <Border Grid.Row="1" Style="{StaticResource Pane}" Visibility="{Binding EnsignPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Width="440" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Ensigns" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding EnsignBudget}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EnsignPips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pip}" Margin="0,0,3,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding EnsignCards}" Margin="0,0,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SelectableRow}" Command="{Binding Command}" Opacity="{Binding CardOpacity}" Margin="0,0,8,8">
                                    <StackPanel Margin="12,10">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Flag}" Width="54" Height="36" Stretch="Fill" Opacity="{Binding FlagOpacity}"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Name}"/>
                                                <TextBlock Text="{Binding Navy}" Style="{StaticResource RowNote}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Style="{StaticResource Points}" VerticalAlignment="Top"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Boon}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding State}" Style="{StaticResource State}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding MainPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Location: a card for each area, then the chosen one's briefing -->
            <Border Style="{StaticResource Pane}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Location" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Rule}"/>
                        <ItemsControl ItemsSource="{Binding Areas}" Margin="0,0,-10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Row}" Command="{Binding Command}" Height="118" Margin="0,0,10,10">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding Art}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border VerticalAlignment="Bottom" Padding="12,18,12,8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#D0000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Name}"/>
                                                        <TextBlock Text="{Binding Region}" FontSize="11" Foreground="{DynamicResource Brush.Foreground.Highlight}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="11" Foreground="{DynamicResource Brush.Foreground.Highlight}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <!-- The painting would hide a red fill, so a card is selected by a red edge -->
                                            <Border BorderBrush="{DynamicResource Brush.Item.BackgroundSelected}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AreaName}" FontSize="16" Foreground="{DynamicResource Brush.Foreground.Highlight}" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding AreaBlurb}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" TextWrapping="Wrap" LineHeight="17"/>
                        <TextBlock Text="{Binding AreaRecord}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Fleet: the navy, its flagships, then the starting ships and flights of that navy -->
            <Border Grid.Column="2" Style="{StaticResource Pane}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- The navies: a flag each. Choosing one changes to its flagship last sailed, and lists its ships below. -->
                        <ItemsControl ItemsSource="{Binding Navies}" Margin="0,0,-6,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Row}" Command="{Binding Command}" Margin="0,0,6,0" Height="44">
                                        <!-- The row template centres its content, so the grid is given the button's height for the edge to run round the whole box -->
                                        <Grid Height="44">
                                            <Image Source="{Binding Flag}" Width="48" Height="32" Stretch="Fill" Opacity="{Binding FlagOpacity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- A flag would hide a red fill, so the navy chosen has a red edge, as an area card does -->
                                            <Border BorderBrush="{DynamicResource Brush.Item.BackgroundSelected}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Flagship" Style="{StaticResource Heading}" Margin="0,6,0,4"/>
                        <Border Style="{StaticResource Rule}"/>
                        <ItemsControl ItemsSource="{Binding Flagships}" ItemTemplate="{StaticResource ShipRow}"/>
                        <Grid Margin="0,14,0,4">
                            <TextBlock Text="Escorts" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Bottom"/>
                            <Button Command="{Binding FormationCommand}" Content="FORMATION" MinWidth="120" Height="30" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Style="{StaticResource Rule}" Margin="0,0,0,8"/>
                        <TextBlock Text="Purchased escorts start active. Click one to deselect it." FontSize="12" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Escorts}" ItemTemplate="{StaticResource ShipRow}"/>
                        <TextBlock Text="{Binding FleetSummary}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Ensigns, then the starting bonuses: the permanent upgrades, rank by rank -->
            <Border Grid.Column="4" Style="{StaticResource Pane}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ensigns" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding EnsignBudget}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </Grid>
                        <Border Style="{StaticResource Rule}"/>
                        <Button Style="{StaticResource Row}" Command="{Binding EnsignsCommand}" Margin="0,0,0,14">
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ItemsControl ItemsSource="{Binding EnsignSlots}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="48" Height="32" Margin="0,0,8,0" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
                                                <Image Source="{Binding Flag}" Stretch="Fill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding EnsignPips}" Grid.Row="1" Margin="0,8,-3,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pip}" Margin="0,0,3,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="2" Text="{Binding EnsignSummary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </Grid>
                        </Button>
                        <TextBlock Text="Starting bonuses" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Rule}" Margin="0,0,0,8"/>
                        <TextBlock Text="Every run gets them. Each rank bought raises the price of the next."
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Bonuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.ListBox.Background}" Padding="12,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Name}"/>
                                                <ItemsControl ItemsSource="{Binding Pips}" Margin="0,5,0,5">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Pip}" Width="18" Margin="0,0,4,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding PerRank}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding Command}" Content="{Binding Price}" VerticalAlignment="Center" Width="88" Height="30"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{DynamicResource HyperlinkButton}" Command="{Binding RefundCommand}" HorizontalAlignment="Left" Padding="0,8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding RefundText}" FontSize="12" Style="{DynamicResource HyperlinkButtonText}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer: BACK, why a launch failed if one did, and LAUNCH, in the game's own buttons. The ensign page has only DONE. -->
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Command="{Binding BackCommand}" Content="{Binding BackText}" Width="160" Height="36" FontSize="14"/>
            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Emphasis}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="24,0" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Command="{Binding LaunchCommand}" Content="{Binding LaunchText}" Visibility="{Binding MainPage}" Width="160" Height="36" FontSize="14"/>
        </Grid>
    </Grid>

    <!-- The Formation Editor: dismissed by its X or a click outside it, as a window over the screen in the game's Task Force mode.
         Drawn here, in the look of the game's Campaign/Window.xaml, whose template lives inside the game's own compiled views.
         Up is the flagship's course; drag a ship to its station. -->
    <Grid Visibility="{Binding FormationWindow}">
        <Button Command="{Binding CloseFormationCommand}" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#99000000"/>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900"
                Background="{DynamicResource Brush.Window.Background}" BorderBrush="{DynamicResource Brush.Border.Normal}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Brush.Window.Header}" IsHitTestVisible="False">
                        <TextBlock Text="FORMATION EDITOR" Margin="2.5,0,0,0" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" Command="{Binding CloseFormationCommand}" Width="20" Padding="0" Margin="0" Focusable="False">
                        <TextBlock FontWeight="Bold" Text="X"/>
                    </Button>
                </Grid>
                    <Grid Grid.Row="1" Margin="10" DataContext="{Binding Formation}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Width="520" Height="520">
                            <Path Data="{Binding Land}" Fill="{DynamicResource Brush.Foreground.Normal}" Opacity="0.35" Width="500" Height="500" IsHitTestVisible="False"/>
                            <Path Stroke="{DynamicResource Brush.TextBox.Foreground}" Opacity="0.25" StrokeThickness="1" Stretch="UniformToFill" Width="500" Height="500"
                                  Data="M -4.5 0.5 A 1 1 0.5 0 0 5.5 0.5 A 1 1 0.5 0 0 -4.5 0.5 M -3.5 0.5 A 1 1 0 0 0 4.5 0.5 A 1 1 0 0 0 -3.5 0.5 M -2.5 0.5 A 1 1 0 0 0 3.5 0.5 A 1 1 0 0 0 -2.5 0.5 M -1.5 0.5 A 1 1 0 0 0 2.5 0.5 A 1 1 0 0 0 -1.5 0.5 M -0.5 0.5 A 1 1 0 0 0 1.5 0.5 A 1 1 0 0 0 -0.5 0.5 M 0.5 5.5 L 0.5 -4.5 M 5.5 0.5 L -4.5 0.5 M -3.8716 -1.9287 L 4.8708 2.9282 M 2.9277 4.8703 L -1.9287 -3.8716 M -3.8708 2.9282 L 4.8716 -1.9287 M 2.9287 -3.8716 L -1.9282 4.8708"/>
                            <Path Stroke="{DynamicResource Brush.TextBox.ForegroundStrongEmphasis}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Data="M 20 0 L 20 -250 L 0 -230 M 40 -230 L 20 -250"/>
                            <TextBlock Text="{Binding ScaleText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Margin="0,0,14,18"/>
                            <!-- Nothing below the plot takes the mouse: FormationPlot finds the nearest ship itself -->
                            <Canvas x:Name="StationPlot" Width="500" Height="500" Background="#01000000"/>
                            <ItemsControl ItemsSource="{Binding Dots}" Width="500" Height="500" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas Width="500" Height="500"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        <Setter Property="Visibility" Value="{Binding Shown}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="0" Height="0">
                                            <Ellipse Width="10" Height="10" Canvas.Left="-5" Canvas.Top="-5">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Button.BackgroundOver}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Foreground.Emphasis}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" Width="150" Canvas.Left="-75" Canvas.Top="6" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Foreground.Highlight}"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Slider Grid.Row="1" Minimum="2" Maximum="{Binding MaxScale}" Value="{Binding Scale, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,8,10,0"/>
                        <ScrollViewer Grid.Column="2" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Up is the flagship's course. Drag a ship to its station. Shaded ground is land or too shallow: a ship placed there starts on the nearest clear water. The slowest ship sets the fleet's speed. Stations can be changed during a run in the game's own Formation Editor."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Dots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.ListBox.Background}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Name}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Highlight}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                                <Button Style="{StaticResource SelectableRow}" Command="{Binding TurnCommand}" Height="34" Margin="0,0,0,4">
                                    <TextBlock Text="Stations turn with the flagship" Style="{StaticResource Name}" FontSize="12" Margin="12,0"/>
                                </Button>
                                <TextBlock Text="{Binding TurnNote}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button Command="{Binding DefaultCommand}" Content="DEFAULT" Width="120" Height="30" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
            </Grid>
        </Border>
    </Grid>
</Grid>

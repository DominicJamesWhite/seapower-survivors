<!-- The main menu's way into Survivors, flush with the right edge of the screen, halfway down: the game's own menu
     button, red on hover, at its size and in its caps, on the dark translucent pane its menu list sits on. Laid out at
     1080p and scaled by MenuButton.cs. Bound to MenuButton.Model. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      HorizontalAlignment="Right" VerticalAlignment="Center">
    <Rectangle Fill="{DynamicResource Brush.Window.BackgroundDark}" Opacity="0.75"/>
    <Button Style="{DynamicResource MenuButton}" Command="{Binding OpenCommand}" Focusable="False" MinWidth="300" Padding="30,15">
        <StackPanel>
            <TextBlock Text="SURVIVORS" FontSize="25"/>
            <TextBlock Text="Hold out for 20 minutes" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Normal}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Bank}" FontSize="12" Foreground="{DynamicResource Brush.Foreground.Emphasis}" Margin="0,2,0,0"/>
        </StackPanel>
    </Button>
</Grid>
